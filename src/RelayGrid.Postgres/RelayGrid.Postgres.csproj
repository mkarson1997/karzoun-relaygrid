<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Karzoun.RelayGrid.Postgres</AssemblyName>
    <RootNamespace>Karzoun.RelayGrid.Postgres</RootNamespace>
    <Description>PostgreSQL durable journal and fenced lease store for RelayGrid.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RelayGrid/RelayGrid.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
